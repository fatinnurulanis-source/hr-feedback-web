<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Manage Feedback | HR Feedback Portal</title>

  <link rel="stylesheet" href="/css/style.css">

  <link
    rel="icon"
    type="image/jpeg"
    href="/images/metropolitan-logo.jpg"
  >

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >
</head>

<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-logo-box">
        <img
          src="/images/metropolitan-logo.jpg"
          alt="Metropolitan College Logo"
          class="sidebar-logo"
        >
      </div>

      <div class="brand-text">
        <h2>HR Feedback Portal</h2>
        <p>HR Feedback Management System</p>
      </div>
    </div>

    <nav>
      <a href="/dashboard">
        <i class="bi bi-grid"></i>
        Dashboard
      </a>

      <a href="/feedback" class="active">
        <i class="bi bi-chat-left-text"></i>
        Manage Feedback
      </a>

      <a href="/report">
        <i class="bi bi-bar-chart"></i>
        Report
      </a>
    </nav>

    <div class="sidebar-footer">
      <p>Version 1.0.0</p>
      <span>© 2026 HR Feedback Portal</span>
    </div>
  </aside>

  <main class="main-content">
    <header class="top-header">
      <div>
        <h1>Manage Feedback</h1>

        <p>
          Review, search and update employee feedback.
        </p>
      </div>

      <div class="user-box">
        <span>
          <i class="bi bi-person-circle"></i>
          <%= currentUser?.displayName || "HR Administrator" %>
        </span>

        <a href="/logout" class="logout-button">
          <i class="bi bi-box-arrow-right"></i>
          Logout
        </a>
      </div>
    </header>

    <% if (successMessage) { %>
      <div class="success-message">
        <i class="bi bi-check-circle"></i>
        <%= successMessage %>
      </div>
    <% } %>

    <% if (errorMessage) { %>
      <div class="error-message">
        <i class="bi bi-exclamation-circle"></i>
        <%= errorMessage %>
      </div>
    <% } %>

    <section class="filter-card">
      <form
        action="/feedback"
        method="GET"
        class="filter-form"
      >
        <div class="filter-field search-field">
          <label for="search">
            Search Feedback
          </label>

          <div class="search-input-wrapper">
            <i class="bi bi-search"></i>

            <input
              type="text"
              id="search"
              name="search"
              value="<%= searchValue %>"
              placeholder="Search category, department, employee or feedback details"
            >
          </div>
        </div>

        <div class="filter-field status-filter-field">
          <label for="status">
            Filter Status
          </label>

          <select id="status" name="status">
            <option
              value="All"
              <%= selectedStatus === "All" ? "selected" : "" %>
            >
              All Status
            </option>

            <option
              value="Pending"
              <%= selectedStatus === "Pending" ? "selected" : "" %>
            >
              Pending
            </option>

            <option
              value="In Progress"
              <%= selectedStatus === "In Progress" ? "selected" : "" %>
            >
              In Progress
            </option>

            <option
              value="Resolved"
              <%= selectedStatus === "Resolved" ? "selected" : "" %>
            >
              Resolved
            </option>
          </select>
        </div>

        <button
          type="submit"
          class="filter-button"
        >
          <i class="bi bi-funnel"></i>
          Apply Filter
        </button>

        <a
          href="/feedback"
          class="reset-button"
        >
          <i class="bi bi-arrow-counterclockwise"></i>
          Reset
        </a>
      </form>
    </section>

    <section class="table-card manage-feedback-container">
      <div class="section-heading">
        <div>
          <h2>Feedback List</h2>

          <p>
            <%= feedbackList.length %> feedback record(s) found.
          </p>
        </div>
      </div>

      <% if (feedbackList.length === 0) { %>

        <div class="empty-state">
          <i class="bi bi-inbox"></i>

          <h3>No feedback found</h3>

          <p>
            Try changing the search keyword or status filter.
          </p>
        </div>

      <% } else { %>

        <div class="manage-feedback-list">
          <% feedbackList.forEach((feedback) => { %>

            <%
              const category =
                feedback.category ||
                feedback.title ||
                "Other";

              const department =
                feedback.department ||
                feedback.responsible_department ||
                "Other";

              const details =
                feedback.message ||
                feedback.description ||
                "No feedback details provided.";

              const statusClass =
                String(feedback.status || "Pending")
                  .trim()
                  .toLowerCase()
                  .replace(/\s+/g, "-");
            %>

            <article class="manage-feedback-card">
              <div class="manage-feedback-information">
                <div class="manage-feedback-heading">
                  <div>
                    <p class="manage-feedback-label">
                      Feedback Category
                    </p>

                    <h3>
                      <%= category %>
                    </h3>
                  </div>

                  <span class="status <%= statusClass %>">
                    <%= feedback.status || "Pending" %>
                  </span>
                </div>

                <div class="department-display">
                  <span class="department-icon">
                    <i class="bi bi-building"></i>
                  </span>

                  <div>
                    <p>Responsible Department</p>
                    <strong><%= department %></strong>
                  </div>
                </div>

                <div class="manage-feedback-details">
                  <h4>
                    <i class="bi bi-chat-left-text"></i>
                    Feedback Details
                  </h4>

                  <p>
                    <%= details %>
                  </p>
                </div>

                <div class="manage-feedback-meta">
                  <span>
                    <i class="bi bi-person"></i>

                    <strong>Submitted By:</strong>

                    <% if (feedback.is_anonymous === true) { %>
                      Anonymous
                    <% } else { %>
                      <%= feedback.submitted_by || "-" %>
                    <% } %>
                  </span>

                  <span>
                    <i class="bi bi-tag"></i>

                    <strong>Category:</strong>
                    <%= category %>
                  </span>
                </div>
              </div>

              <div class="manage-feedback-control">
                <form
                  action="/feedback/<%= feedback.id %>/update"
                  method="POST"
                  class="feedback-update-form"
                >
                  <div class="update-form-field">
                    <label for="status-<%= feedback.id %>">
                      Status
                    </label>

                    <select
                      id="status-<%= feedback.id %>"
                      name="status"
                      required
                    >
                      <option
                        value="Pending"
                        <%= feedback.status === "Pending" ? "selected" : "" %>
                      >
                        Pending
                      </option>

                      <option
                        value="In Progress"
                        <%= feedback.status === "In Progress" ? "selected" : "" %>
                      >
                        In Progress
                      </option>

                      <option
                        value="Resolved"
                        <%= feedback.status === "Resolved" ? "selected" : "" %>
                      >
                        Resolved
                      </option>
                    </select>
                  </div>

                  <div class="update-form-field">
                    <label for="response-<%= feedback.id %>">
                      HR Response
                    </label>

                    <textarea
                      id="response-<%= feedback.id %>"
                      name="hr_response"
                      rows="5"
                      placeholder="Enter HR response"
                    ><%= feedback.hr_response || "" %></textarea>
                  </div>

                  <button
                    type="submit"
                    class="update-button"
                  >
                    <i class="bi bi-check-circle"></i>
                    Update Feedback
                  </button>

                  <a
                    href="/report/<%= feedback.id %>"
                    class="manage-view-detail-button"
                  >
                    <i class="bi bi-eye"></i>
                    View Details
                  </a>
                </form>
              </div>
            </article>

          <% }); %>
        </div>

      <% } %>
    </section>

    <footer class="system-footer">
      <p>HR Feedback Portal © 2026</p>
      <p>Developed by Fatin Nurul Anis</p>
    </footer>
  </main>
</body>
</html>