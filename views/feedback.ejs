<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

 <title>Manage Feedback | HR Feedback Portal</title>

  <link rel="stylesheet" href="/css/style.css">

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >
  <link
  rel="icon"
  type="image/jpeg"
  href="/images/metropolitan-logo.jpg"
>
</head>

<body>
 <aside class="sidebar">
  <div class="sidebar-brand">
    <div class="sidebar-logo-box">
      <img
        src="/images/metropolitan-logo.jpg"
        alt="Metropolitan College Logo"
        class="sidebar-logo"
      >
    </div>

    <div class="brand-text">
      <h2>HR Feedback Portal</h2>
      <p>HR Feedback Management System</p>
    </div>
  </div>

  <nav>
    <a href="/dashboard">
      <i class="bi bi-grid"></i>
      Dashboard
    </a>

    <a href="/feedback" class="active">
      <i class="bi bi-chat-left-text"></i>
      Manage Feedback
    </a>

    <a href="/report">
      <i class="bi bi-bar-chart"></i>
      Report
    </a>
  </nav>

  <div class="sidebar-footer">
    <p>Version 1.0.0</p>
    <span>© 2026 HR Feedback Portal</span>
  </div>
</aside>

  <main class="main-content">
    <header class="top-header">
      <div>
        <h1>Manage Feedback</h1>

        <p>
          Review, search and update employee feedback.
        </p>
      </div>

      <div class="user-box">
        <span>
          <i class="bi bi-person-circle"></i>

          <%= currentUser?.displayName || "HR Administrator" %>
        </span>

        <a href="/logout" class="logout-button">
          <i class="bi bi-box-arrow-right"></i>
          Logout
        </a>
      </div>
    </header>

    <% if (successMessage) { %>
      <div class="alert success-alert">
        <i class="bi bi-check-circle"></i>
        <%= successMessage %>
      </div>
    <% } %>

    <% if (errorMessage) { %>
      <div class="alert error-alert">
        <i class="bi bi-exclamation-circle"></i>
        <%= errorMessage %>
      </div>
    <% } %>

    <section class="filter-card">
      <form
        action="/feedback"
        method="GET"
        class="filter-form"
      >
        <div class="filter-group search-group">
          <label for="search">
            Search Feedback
          </label>

          <div class="search-input-wrapper">
            <i class="bi bi-search"></i>

            <input
              type="search"
              id="search"
              name="search"
              value="<%= searchValue %>"
              placeholder="Search title, category or employee"
            >
          </div>
        </div>

        <div class="filter-group">
          <label for="status">
            Filter Status
          </label>

          <select
            id="status"
            name="status"
          >
            <option
              value="All"
              <%= selectedStatus === "All"
                ? "selected"
                : "" %>
            >
              All Status
            </option>

            <option
              value="Pending"
              <%= selectedStatus === "Pending"
                ? "selected"
                : "" %>
            >
              Pending
            </option>

            <option
              value="In Progress"
              <%= selectedStatus === "In Progress"
                ? "selected"
                : "" %>
            >
              In Progress
            </option>

            <option
              value="Resolved"
              <%= selectedStatus === "Resolved"
                ? "selected"
                : "" %>
            >
              Resolved
            </option>
          </select>
        </div>

        <div class="filter-actions">
          <button
            type="submit"
            class="filter-button"
          >
            <i class="bi bi-funnel"></i>
            Apply Filter
          </button>

          <a
            href="/feedback"
            class="reset-button"
          >
            <i class="bi bi-arrow-counterclockwise"></i>
            Reset
          </a>
        </div>
      </form>
    </section>

    <section class="table-card">
      <div class="section-heading">
        <div>
          <h2>Feedback List</h2>

          <p>
            <%= feedbackList.length %>
            feedback record(s) found.
          </p>
        </div>
      </div>

      <% if (feedbackList.length === 0) { %>

        <div class="empty-state">
          <i class="bi bi-inbox empty-icon"></i>

          <h3>No feedback found</h3>

          <p>
            Try using another keyword or status filter.
          </p>
        </div>

      <% } else { %>

        <div class="feedback-list">
          <% feedbackList.forEach((feedback) => { %>

            <% const statusClass =
              String(feedback.status || "Pending")
                .trim()
                .toLowerCase()
                .replace(/\s+/g, "-");
            %>

            <article class="feedback-item">
              <div class="feedback-main">
                <div class="feedback-title-row">
                  <div>
                    <h3>
                      <%= feedback.title || "-" %>
                    </h3>

                    <p class="feedback-category">
                      <i class="bi bi-tag"></i>
                      <%= feedback.category || "Uncategorized" %>
                    </p>
                  </div>

                  <span class="status <%= statusClass %>">
                    <%= feedback.status || "Pending" %>
                  </span>
                </div>

                <p class="feedback-description">
                  <%= feedback.message ||
                      feedback.description ||
                      "No description provided." %>
                </p>

                <div class="feedback-meta">
                  <span>
                    <i class="bi bi-person"></i>

                    <strong>Submitted By:</strong>

                    <% if (feedback.is_anonymous === true) { %>
                      Anonymous
                    <% } else { %>
                      <%= feedback.submitted_by || "-" %>
                    <% } %>
                  </span>

                  <span>
                    <i class="bi bi-chat-square-text"></i>

                    <strong>HR Response:</strong>

                    <%= feedback.hr_response ||
                        "No response yet" %>
                  </span>
                </div>
              </div>

              <form
                action="/feedback/<%= feedback.id %>/update"
                method="POST"
                class="update-form feedback-update-form"
              >
                <label>
                  Status

                  <select name="status" required>
                    <option
                      value="Pending"
                      <%= feedback.status === "Pending"
                        ? "selected"
                        : "" %>
                    >
                      Pending
                    </option>

                    <option
                      value="In Progress"
                      <%= feedback.status === "In Progress"
                        ? "selected"
                        : "" %>
                    >
                      In Progress
                    </option>

                    <option
                      value="Resolved"
                      <%= feedback.status === "Resolved"
                        ? "selected"
                        : "" %>
                    >
                      Resolved
                    </option>
                  </select>
                </label>

                <label>
                  HR Response

                  <textarea
                    name="hr_response"
                    rows="4"
                    placeholder="Enter HR response"
                  ><%= feedback.hr_response || "" %></textarea>
                </label>

                <button
                  type="submit"
                  class="update-button"
                >
                  <i class="bi bi-check-circle"></i>
                  Update Feedback
                </button>
              </form>
            </article>

          <% }); %>
        </div>

      <% } %>
    </section>

    <footer class="system-footer">
      <p>
        HR Feedback System © 2026
      </p>

      <p>
        Developed by Fatin Nurul Anis
      </p>
    </footer>
  </main>
</body>
</html>