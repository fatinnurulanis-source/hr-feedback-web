<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Dashboard | HR Feedback Portal</title>

  <link rel="stylesheet" href="/css/style.css">

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >
  <link
  rel="icon"
  type="image/jpeg"
  href="/images/metropolitan-logo.jpg"
>
</head>

<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-logo-box">
        <img
          src="/images/metropolitan-logo.jpg"
          alt="Metropolitan College Logo"
          class="sidebar-logo"
        >
      </div>

      <div class="brand-text">
        <h2>HR Feedback Portal</h2>
        <p>HR Feedback Management System</p>
      </div>
    </div>

    <nav>
      <a href="/dashboard" class="active">
        <i class="bi bi-grid"></i>
        Dashboard
      </a>

      <a href="/feedback">
        <i class="bi bi-chat-left-text"></i>
        Manage Feedback
      </a>

      <a href="/report">
        <i class="bi bi-bar-chart"></i>
        Report
      </a>
    </nav>

    <div class="sidebar-footer">
      <p>Version 1.0.0</p>
      <span>© 2026 HR Feedback Portal</span>
    </div>
  </aside>

  <main class="main-content">
    <header class="top-header">
      <div>
        <h1>
          Welcome,
          <%= currentUser?.displayName || "HR Administrator" %>
          👋
        </h1>

        <p>
          Monitor feedback statistics and manage employee submissions.
        </p>
      </div>

      <div class="user-box">
        <span>
          <i class="bi bi-person-circle"></i>

          <%= currentUser?.displayName || "HR Administrator" %>
        </span>

        <a href="/logout" class="logout-button">
          <i class="bi bi-box-arrow-right"></i>
          Logout
        </a>
      </div>
    </header>

    <!-- Summary cards -->
    <section class="summary-grid">
      <a
        href="/feedback?status=All"
        class="summary-card summary-link"
      >
        <div class="summary-card-header">
          <div>
            <p class="summary-label">
              Total Feedback
            </p>

            <h2><%= totalFeedback %></h2>
          </div>

          <div class="summary-icon">
            <i class="bi bi-list-task"></i>
          </div>
        </div>

        <span class="summary-action">
          View all feedback
          <i class="bi bi-arrow-right"></i>
        </span>
      </a>

      <a
        href="/feedback?status=Pending"
        class="summary-card summary-link"
      >
        <div class="summary-card-header">
          <div>
            <p class="summary-label">
              Pending
            </p>

            <h2><%= pendingFeedback %></h2>
          </div>

          <div class="summary-icon">
            <i class="bi bi-hourglass-split"></i>
          </div>
        </div>

        <span class="summary-action">
          View pending feedback
          <i class="bi bi-arrow-right"></i>
        </span>
      </a>

      <a
        href="/feedback?status=In%20Progress"
        class="summary-card summary-link"
      >
        <div class="summary-card-header">
          <div>
            <p class="summary-label">
              In Progress
            </p>

            <h2><%= inProgressFeedback %></h2>
          </div>

          <div class="summary-icon">
            <i class="bi bi-arrow-repeat"></i>
          </div>
        </div>

        <span class="summary-action">
          View current feedback
          <i class="bi bi-arrow-right"></i>
        </span>
      </a>

      <a
        href="/feedback?status=Resolved"
        class="summary-card summary-link"
      >
        <div class="summary-card-header">
          <div>
            <p class="summary-label">
              Resolved
            </p>

            <h2><%= resolvedFeedback %></h2>
          </div>

          <div class="summary-icon">
            <i class="bi bi-check-circle"></i>
          </div>
        </div>

        <span class="summary-action">
          View completed feedback
          <i class="bi bi-arrow-right"></i>
        </span>
      </a>
    </section>

    <!-- Report data moved to dashboard -->
    <section class="dashboard-analytics-grid">
      <div class="report-panel dashboard-chart-panel">
        <div class="report-heading">
          <h2>
            <i class="bi bi-pie-chart"></i>
            Status Distribution
          </h2>

          <p>
            Distribution of feedback according to current status.
          </p>
        </div>

        <div class="dashboard-chart-container">
          <canvas id="statusChart"></canvas>
        </div>
      </div>

      <div class="report-panel dashboard-chart-panel">
        <div class="report-heading">
          <h2>
            <i class="bi bi-bar-chart"></i>
            Feedback by Category
          </h2>

          <p>
            Total feedback submissions for each category.
          </p>
        </div>

        <div class="dashboard-chart-container">
          <canvas id="categoryChart"></canvas>
        </div>
      </div>
    </section>

    <!-- Recent feedback + side panels -->
    <section class="dashboard-layout">
      <div class="table-card">
        <div class="section-heading">
          <div>
            <h2>
              <i class="bi bi-clock-history"></i>
              Recent Feedback
            </h2>

            <p>
              Latest feedback submitted by employees.
            </p>
          </div>

          <a href="/feedback" class="view-button">
            View All
          </a>
        </div>

        <% if (feedbackList.length === 0) { %>

          <div class="empty-state">
            <i class="bi bi-inbox empty-icon"></i>

            <h3>No feedback available</h3>

            <p>
              New employee feedback will appear here.
            </p>
          </div>

        <% } else { %>

          <div class="recent-feedback-list">
            <% feedbackList.slice(0, 5).forEach((feedback) => { %>

              <% const statusClass =
                String(feedback.status || "Pending")
                  .trim()
                  .toLowerCase()
                  .replace(/\s+/g, "-");
              %>

              <article class="recent-feedback-item">
                <div class="recent-feedback-content">
                  <div class="recent-feedback-title-row">
                    <div>
                      <h3>
                        <%= feedback.title || "-" %>
                      </h3>

                      <p class="feedback-category">
                        <i class="bi bi-tag"></i>
                        <%= feedback.category || "Uncategorized" %>
                      </p>
                    </div>

                    <span class="status <%= statusClass %>">
                      <%= feedback.status || "Pending" %>
                    </span>
                  </div>

                  <p class="feedback-description">
                    <%= feedback.message ||
                        feedback.description ||
                        "No description provided." %>
                  </p>

                  <div class="feedback-meta">
                    <span>
                      <i class="bi bi-person"></i>

                      <% if (feedback.is_anonymous === true) { %>
                        Anonymous
                      <% } else { %>
                        <%= feedback.submitted_by || "-" %>
                      <% } %>
                    </span>

                    <span>
                      <i class="bi bi-tag"></i>
                      <%= feedback.category || "Uncategorized" %>
                    </span>
                  </div>
                </div>

                <a
                  href="/feedback?search=<%= encodeURIComponent(feedback.title || "") %>"
                  class="small-button"
                >
                  Manage
                  <i class="bi bi-arrow-right"></i>
                </a>
              </article>

            <% }); %>
          </div>

        <% } %>
      </div>

      <aside class="dashboard-side-panel">
        <!-- Quick actions first -->
        <div class="report-panel quick-action-panel">
          <div class="report-heading">
            <h2>
              <i class="bi bi-lightning-charge"></i>
              Quick Actions
            </h2>

            <p>
              Access important HR functions.
            </p>
          </div>

          <div class="quick-action-list">
            <a
              href="/feedback"
              class="quick-action-link"
            >
              <i class="bi bi-chat-left-text"></i>

              <span>Manage Feedback</span>
            </a>

            <a
              href="/report"
              class="quick-action-link"
            >
              <i class="bi bi-file-earmark-bar-graph"></i>

              <span>View Feedback Report</span>
            </a>

            <a
              href="/feedback?status=Pending"
              class="quick-action-link"
            >
              <i class="bi bi-hourglass-split"></i>

              <span>Review Pending</span>
            </a>

            <a
              href="/feedback?status=In%20Progress"
              class="quick-action-link"
            >
              <i class="bi bi-arrow-repeat"></i>

              <span>Review Current</span>
            </a>
          </div>
        </div>

        <!-- System overview -->
        <div class="report-panel dashboard-summary-panel">
          <div class="report-heading">
            <h2>
              <i class="bi bi-diagram-3"></i>
              System Overview
            </h2>

            <p>
              Current HR feedback workflow.
            </p>
          </div>

          <div class="overview-list">
            <div class="overview-item">
              <div class="overview-icon">
                <i class="bi bi-phone"></i>
              </div>

              <div>
                <h3>Employee Mobile App</h3>

                <p>
                  Employees submit feedback through the FlutterFlow application.
                </p>
              </div>
            </div>

            <div class="overview-item">
              <div class="overview-icon">
                <i class="bi bi-database"></i>
              </div>

              <div>
                <h3>Firebase Database</h3>

                <p>
                  Feedback and notifications are stored centrally in Firestore.
                </p>
              </div>
            </div>

            <div class="overview-item">
              <div class="overview-icon">
                <i class="bi bi-laptop"></i>
              </div>

              <div>
                <h3>HR Web Portal</h3>

                <p>
                  HR reviews, responds to and updates employee feedback.
                </p>
              </div>
            </div>
          </div>
        </div>
      </aside>
    </section>

    <footer class="system-footer">
      <p>
        HR Feedback Portal © 2026
      </p>

      <p>
        Developed by Fatin Nurul Anis
      </p>
    </footer>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script type="application/json" id="dashboard-chart-data">
    <%- JSON.stringify({
      pending: pendingFeedback,
      inProgress: inProgressFeedback,
      resolved: resolvedFeedback,
      categoryLabels: categoryLabels,
      categoryValues: categoryValues
    }) %>
  </script>

  <script>
    const chartDataElement =
      document.getElementById(
        "dashboard-chart-data"
      );

    const chartData = JSON.parse(
      chartDataElement.textContent
    );

    const statusCanvas =
      document.getElementById("statusChart");

    new Chart(statusCanvas, {
      type: "doughnut",

      data: {
        labels: [
          "Pending",
          "In Progress",
          "Resolved"
        ],

        datasets: [
          {
            data: [
              chartData.pending,
              chartData.inProgress,
              chartData.resolved
            ],

            backgroundColor: [
              "#f4c95d",
              "#6ca6e8",
              "#72c48d"
            ],

            borderWidth: 0
          }
        ]
      },

      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: "62%",

        plugins: {
          legend: {
            position: "bottom"
          }
        }
      }
    });

    const categoryCanvas =
      document.getElementById(
        "categoryChart"
      );

    new Chart(categoryCanvas, {
      type: "bar",

      data: {
        labels: chartData.categoryLabels,

        datasets: [
          {
            label: "Feedback",
            data: chartData.categoryValues,
            backgroundColor: "#3d3b8e",
            borderRadius: 7
          }
        ]
      },

      options: {
        responsive: true,
        maintainAspectRatio: false,

        scales: {
          y: {
            beginAtZero: true,

            ticks: {
              precision: 0
            }
          }
        },

        plugins: {
          legend: {
            display: false
          }
        }
      }
    });
  </script>
</body>
</html>