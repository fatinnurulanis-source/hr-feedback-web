<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>HR Dashboard</title>

  <link rel="stylesheet" href="/css/style.css">

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >
</head>

<body>
  <aside class="sidebar">
    <div class="brand">
      <h2>HR Feedback</h2>
      <p>Management System</p>
    </div>

    <nav>
      <a href="/dashboard" class="active">
        <i class="bi bi-grid"></i>
        Dashboard
      </a>

      <a href="/feedback">
        <i class="bi bi-chat-left-text"></i>
        Manage Feedback
      </a>

      <a href="/report">
        <i class="bi bi-bar-chart"></i>
        Report
      </a>
    </nav>
  </aside>

  <main class="main-content">
    <header class="top-header">
      <div>
        <h1>
          Welcome,
          <%= currentUser?.displayName || "HR Administrator" %>
          👋
        </h1>

        <p>
          Manage employee feedback and monitor current progress.
        </p>
      </div>

      <div class="user-box">
        <span>
          <i class="bi bi-person-circle"></i>
          <%= currentUser?.displayName || "HR Administrator" %>
        </span>

        <a href="/logout" class="logout-button">
          <i class="bi bi-box-arrow-right"></i>
          Logout
        </a>
      </div>
    </header>

    <section class="summary-grid">
      <a
        href="/feedback?status=All"
        class="summary-card summary-link"
      >
        <div class="summary-card-header">
          <div>
            <p class="summary-label">
              Total Feedback
            </p>

            <h2><%= totalFeedback %></h2>
          </div>

          <div class="summary-icon">
            <i class="bi bi-list-task"></i>
          </div>
        </div>

        <span class="summary-action">
          View all feedback
          <i class="bi bi-arrow-right"></i>
        </span>
      </a>

      <a
        href="/feedback?status=Pending"
        class="summary-card summary-link"
      >
        <div class="summary-card-header">
          <div>
            <p class="summary-label">
              Pending
            </p>

            <h2><%= pendingFeedback %></h2>
          </div>

          <div class="summary-icon">
            <i class="bi bi-hourglass-split"></i>
          </div>
        </div>

        <span class="summary-action">
          View pending feedback
          <i class="bi bi-arrow-right"></i>
        </span>
      </a>

      <a
        href="/feedback?status=In%20Progress"
        class="summary-card summary-link"
      >
        <div class="summary-card-header">
          <div>
            <p class="summary-label">
              In Progress
            </p>

            <h2><%= inProgressFeedback %></h2>
          </div>

          <div class="summary-icon">
            <i class="bi bi-arrow-repeat"></i>
          </div>
        </div>

        <span class="summary-action">
          View ongoing feedback
          <i class="bi bi-arrow-right"></i>
        </span>
      </a>

      <a
        href="/feedback?status=Resolved"
        class="summary-card summary-link"
      >
        <div class="summary-card-header">
          <div>
            <p class="summary-label">
              Resolved
            </p>

            <h2><%= resolvedFeedback %></h2>
          </div>

          <div class="summary-icon">
            <i class="bi bi-check-circle"></i>
          </div>
        </div>

        <span class="summary-action">
          View resolved feedback
          <i class="bi bi-arrow-right"></i>
        </span>
      </a>
    </section>

    <section class="dashboard-layout">
      <div class="table-card">
        <div class="section-heading">
          <div>
            <h2>Recent Feedback</h2>

            <p>
              Latest feedback submitted by employees.
            </p>
          </div>

          <a href="/feedback" class="view-button">
            View All
          </a>
        </div>

        <% if (feedbackList.length === 0) { %>

          <div class="empty-state">
            <h3>No feedback available</h3>

            <p>
              New employee feedback will appear here.
            </p>
          </div>

        <% } else { %>

          <div class="recent-feedback-list">
            <% feedbackList.slice(0, 5).forEach((feedback) => { %>

              <% const statusClass =
                String(feedback.status || "Pending")
                  .trim()
                  .toLowerCase()
                  .replace(/\s+/g, "-");
              %>

              <article class="recent-feedback-item">
                <div class="recent-feedback-content">
                  <div class="recent-feedback-title-row">
                    <div>
                      <h3>
                        <%= feedback.title || "-" %>
                      </h3>

                      <p class="feedback-category">
                        <%= feedback.category || "Uncategorized" %>
                      </p>
                    </div>

                    <span class="status <%= statusClass %>">
                      <%= feedback.status || "Pending" %>
                    </span>
                  </div>

                  <p class="feedback-description">
                    <%= feedback.message ||
                        feedback.description ||
                        "No description provided." %>
                  </p>

                  <div class="feedback-meta">
                    <span>
                      <i class="bi bi-person"></i>

                      <% if (feedback.is_anonymous === true) { %>
                        Anonymous
                      <% } else { %>
                        <%= feedback.submitted_by || "-" %>
                      <% } %>
                    </span>

                    <span>
                      <i class="bi bi-tag"></i>
                      <%= feedback.category || "Uncategorized" %>
                    </span>
                  </div>
                </div>

                <a
                  href="/feedback?search=<%= encodeURIComponent(feedback.title || "") %>"
                  class="small-button"
                >
                  Manage
                  <i class="bi bi-arrow-right"></i>
                </a>
              </article>

            <% }); %>
          </div>

        <% } %>
      </div>

      <aside class="dashboard-side-panel">
        <div class="report-panel dashboard-summary-panel">
          <div class="report-heading">
            <h2>System Overview</h2>

            <p>
              Current HR feedback workflow.
            </p>
          </div>

          <div class="overview-list">
            <div class="overview-item">
              <div class="overview-icon">
                <i class="bi bi-phone"></i>
              </div>

              <div>
                <h3>Employee Mobile App</h3>
                <p>
                  Employees submit feedback through FlutterFlow.
                </p>
              </div>
            </div>

            <div class="overview-item">
              <div class="overview-icon">
                <i class="bi bi-database"></i>
              </div>

              <div>
                <h3>Firebase Database</h3>
                <p>
                  Feedback and notifications are stored centrally.
                </p>
              </div>
            </div>

            <div class="overview-item">
              <div class="overview-icon">
                <i class="bi bi-laptop"></i>
              </div>

              <div>
                <h3>HR Web Portal</h3>
                <p>
                  HR reviews, responds to and updates feedback.
                </p>
              </div>
            </div>
          </div>
        </div>

        <div class="report-panel quick-action-panel">
          <div class="report-heading">
            <h2>Quick Actions</h2>

            <p>
              Access important HR functions.
            </p>
          </div>

          <div class="quick-action-list">
            <a href="/feedback" class="quick-action-link">
              <i class="bi bi-chat-left-text"></i>

              <span>
                Manage Feedback
              </span>
            </a>

            <a href="/report" class="quick-action-link">
              <i class="bi bi-bar-chart"></i>

              <span>
                View Report
              </span>
            </a>

            <a href="/feedback?status=Pending" class="quick-action-link">
              <i class="bi bi-hourglass-split"></i>

              <span>
                Review Pending
              </span>
            </a>
          </div>
        </div>
      </aside>
    </section>

    <footer class="system-footer">
      <p>
        HR Feedback System © 2026
      </p>

      <p>
        Developed by Fatin Nurul Anis
      </p>
    </footer>
  </main>
</body>
</html>