<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Login | HR Feedback Portal</title>

  <link rel="stylesheet" href="/css/style.css">

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >
  <link
  rel="icon"
  type="image/jpeg"
  href="/images/metropolitan-logo.jpg"
>
</head>

<body class="login-page">
  <main class="login-split-layout">
    <section class="login-brand-panel">
      <div class="login-brand-content">
        <div class="login-brand-logo-box">
          <img
            src="/images/metropolitan-logo.jpg"
            alt="Metropolitan College Logo"
            class="login-brand-logo"
          >
        </div>

        <p class="login-brand-label">
          Metropolitan College
        </p>

        <h1>HR Feedback Portal</h1>

        <p class="login-brand-tagline">
          HR Feedback Management System
        </p>

        <p class="login-brand-description">
          A centralized portal for HR administrators to review,
          manage and respond to employee feedback.
        </p>

        <div class="login-feature-list">
          <div class="login-feature-item">
            <i class="bi bi-chat-left-text"></i>
            <span>Manage employee feedback</span>
          </div>

          <div class="login-feature-item">
            <i class="bi bi-bar-chart"></i>
            <span>Monitor reports and statistics</span>
          </div>

          <div class="login-feature-item">
            <i class="bi bi-shield-check"></i>
            <span>Secure HR administrator access</span>
          </div>
        </div>
      </div>

      <div class="login-brand-footer">
        <span>Version 1.0.0</span>
        <span>© 2026 Metropolitan College</span>
      </div>
    </section>

    <section class="login-form-panel">
      <div class="login-form-card">
        <div class="login-form-header">
          <span class="login-form-icon">
            <i class="bi bi-person-lock"></i>
          </span>

          <h2>Welcome Back</h2>

          <p>
            Sign in using your HR administrator account.
          </p>
        </div>

        <form id="login-form" class="login-form">
          <label for="email">
            Email Address
          </label>

          <div class="login-input-wrapper">
            <i class="bi bi-envelope"></i>

            <input
              type="email"
              id="email"
              placeholder="Enter HR email"
              autocomplete="email"
              required
            >
          </div>

          <label for="password">
            Password
          </label>

          <div class="login-input-wrapper">
            <i class="bi bi-lock"></i>

            <input
              type="password"
              id="password"
              placeholder="Enter password"
              autocomplete="current-password"
              required
            >
          </div>

          <button type="submit" id="login-button">
            <i class="bi bi-box-arrow-in-right"></i>
            Sign In
          </button>

          <p
            id="login-error"
            class="form-error"
            aria-live="polite"
          ></p>
        </form>

        <div class="login-security-note">
          <i class="bi bi-shield-lock"></i>

          <p>
            Access is restricted to authorized HR administrators only.
          </p>
        </div>
      </div>
    </section>
  </main>

  <script type="module">
    import {
      initializeApp
    } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-app.js";

    import {
      getAuth,
      signInWithEmailAndPassword
    } from "https://www.gstatic.com/firebasejs/12.1.0/firebase-auth.js";

    const firebaseConfig = {
      apiKey: "AIzaSyAzX621V6O8lK4U9VYNN2GIG7RkekwIp0w",
      authDomain: "hr-feedback-system-8edc5.firebaseapp.com",
      projectId: "hr-feedback-system-8edc5",
      storageBucket: "hr-feedback-system-8edc5.firebasestorage.app",
      messagingSenderId: "849257547861",
      appId: "1:849257547861:web:ce0f4d80d3c48ecc1eecdc",
      measurementId: "G-J1J2LWN1E7"
    };

    const firebaseApp = initializeApp(firebaseConfig);
    const firebaseAuth = getAuth(firebaseApp);

    const loginForm =
      document.getElementById("login-form");

    const loginButton =
      document.getElementById("login-button");

    const loginError =
      document.getElementById("login-error");

    loginForm.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();

        loginError.textContent = "";
        loginButton.disabled = true;
        loginButton.innerHTML =
          '<span class="login-spinner"></span> Signing In...';

        const email =
          document.getElementById("email").value.trim();

        const password =
          document.getElementById("password").value;

        try {
          const credential =
            await signInWithEmailAndPassword(
              firebaseAuth,
              email,
              password
            );

          const idToken =
            await credential.user.getIdToken();

          const response = await fetch(
            "/auth/session",
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                idToken
              })
            }
          );

          const result = await response.json();

          if (!response.ok) {
            throw new Error(
              result.message || "Login failed."
            );
          }

          window.location.href = "/dashboard";
        } catch (error) {
          console.error("Login error:", error);

          loginError.textContent =
            error.message ||
            "Invalid email or password.";

          loginButton.disabled = false;
          loginButton.innerHTML =
            '<i class="bi bi-box-arrow-in-right"></i> Sign In';
        }
      }
    );
  </script>
</body>
</html>