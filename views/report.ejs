<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Feedback Report | HR Feedback Portal</title>

  <link rel="stylesheet" href="/css/style.css">

  <link
    rel="icon"
    type="image/jpeg"
    href="/images/metropolitan-logo.jpg"
  >

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >
</head>

<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-logo-box">
        <img
          src="/images/metropolitan-logo.jpg"
          alt="Metropolitan College Logo"
          class="sidebar-logo"
        >
      </div>

      <div class="brand-text">
        <h2>HR Feedback Portal</h2>
        <p>HR Feedback Management System</p>
      </div>
    </div>

    <nav>
      <a href="/dashboard">
        <i class="bi bi-grid"></i>
        Dashboard
      </a>

      <a href="/feedback">
        <i class="bi bi-chat-left-text"></i>
        Manage Feedback
      </a>

      <a href="/report" class="active">
        <i class="bi bi-bar-chart"></i>
        Report
      </a>
    </nav>

    <div class="sidebar-footer">
      <p>Version 1.0.0</p>
      <span>© 2026 HR Feedback Portal</span>
    </div>
  </aside>

  <main class="main-content">
    <header class="top-header">
      <div>
        <h1>Feedback Report</h1>

        <p>
          Review feedback records based on their current status.
        </p>
      </div>

      <div class="report-header-actions">
        <a
          href="/report/pdf"
          class="download-report-button"
        >
          <i class="bi bi-file-earmark-pdf"></i>
          Download Full Report
        </a>

        <div class="user-box">
          <span>
            <i class="bi bi-person-circle"></i>
            <%= currentUser?.displayName || "HR Administrator" %>
          </span>

          <a href="/logout" class="logout-button">
            <i class="bi bi-box-arrow-right"></i>
            Logout
          </a>
        </div>
      </div>
    </header>

    <section class="report-status-navigation">
      <a href="#pending-section" class="report-status-link">
        <i class="bi bi-hourglass-split"></i>

        <div>
          <span>Pending</span>
          <strong><%= pendingList.length %></strong>
        </div>
      </a>

      <a href="#current-section" class="report-status-link">
        <i class="bi bi-arrow-repeat"></i>

        <div>
          <span>Current</span>
          <strong><%= inProgressList.length %></strong>
        </div>
      </a>

      <a href="#completed-section" class="report-status-link">
        <i class="bi bi-check-circle"></i>

        <div>
          <span>Completed</span>
          <strong><%= resolvedList.length %></strong>
        </div>
      </a>
    </section>

    <%
      const renderFeedbackSection = (
        sectionId,
        sectionTitle,
        sectionDescription,
        feedbackList,
        defaultStatus,
        statusClass
      ) => {
    %>

    <section
      id="<%= sectionId %>"
      class="report-list-section"
    >
      <div class="section-heading">
        <div>
          <h2><%= sectionTitle %></h2>
          <p><%= sectionDescription %></p>
        </div>

        <span class="report-record-count">
          <%= feedbackList.length %> record(s)
        </span>
      </div>

      <% if (feedbackList.length === 0) { %>

        <div class="report-empty-state">
          <i class="bi bi-inbox"></i>
          <h3>No feedback records</h3>
          <p>There are currently no records in this section.</p>
        </div>

      <% } else { %>

        <div class="report-feedback-list">
          <% feedbackList.forEach((feedback) => { %>

            <%
              const category =
                feedback.category ||
                feedback.title ||
                "Other";

              const department =
                feedback.department ||
                feedback.responsible_department ||
                "Other";

              const details =
                feedback.message ||
                feedback.description ||
                "No feedback details provided.";
            %>

            <article class="report-feedback-card">
              <div class="report-feedback-header">
                <div>
                  <h3><%= category %></h3>

                  <p class="feedback-category">
                    <i class="bi bi-building"></i>
                    Responsible Department:
                    <strong><%= department %></strong>
                  </p>
                </div>

                <span class="status <%= statusClass %>">
                  <%= feedback.status || defaultStatus %>
                </span>
              </div>

              <div class="feedback-detail-section">
                <h4>Feedback Details</h4>
                <p class="feedback-description">
                  <%= details %>
                </p>
              </div>

              <div class="feedback-meta">
                <span>
                  <i class="bi bi-person"></i>

                  <strong>Submitted By:</strong>

                  <% if (feedback.is_anonymous === true) { %>
                    Anonymous
                  <% } else { %>
                    <%= feedback.submitted_by || "-" %>
                  <% } %>
                </span>

                <span>
                  <i class="bi bi-chat-square-text"></i>

                  <strong>HR Response:</strong>

                  <%= feedback.hr_response || "No response yet" %>
                </span>
              </div>

              <div class="report-card-actions">
                <a
                  href="/report/<%= feedback.id %>"
                  class="view-detail-button"
                >
                  <i class="bi bi-eye"></i>
                  View Details
                </a>
              </div>
            </article>

          <% }); %>
        </div>

      <% } %>
    </section>

    <%
      };
    %>

    <%
      renderFeedbackSection(
        "pending-section",
        "Pending Feedback",
        "Feedback that has not yet been reviewed by HR.",
        pendingList,
        "Pending",
        "pending"
      );
    %>

    <%
      renderFeedbackSection(
        "current-section",
        "Current Feedback",
        "Feedback that is currently being reviewed or processed.",
        inProgressList,
        "In Progress",
        "in-progress"
      );
    %>

    <%
      renderFeedbackSection(
        "completed-section",
        "Completed Feedback",
        "Feedback that has been reviewed and resolved by HR.",
        resolvedList,
        "Resolved",
        "resolved"
      );
    %>

    <footer class="system-footer">
      <p>HR Feedback Portal © 2026</p>
      <p>Developed by Fatin Nurul Anis</p>
    </footer>
  </main>
</body>
</html>