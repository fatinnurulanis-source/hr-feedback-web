<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>Feedback Report | HR Feedback Portal</title>

  <link rel="stylesheet" href="/css/style.css">

  <link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
  >
  <link
  rel="icon"
  type="image/jpeg"
  href="/images/metropolitan-logo.jpg"
>
</head>

<body>
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="sidebar-logo-box">
        <img
          src="/images/metropolitan-logo.jpg"
          alt="Metropolitan College Logo"
          class="sidebar-logo"
        >
      </div>

      <div class="brand-text">
        <h2>HR Feedback Portal</h2>
        <p>HR Feedback Management System</p>
      </div>
    </div>

    <nav>
      <a href="/dashboard">
        <i class="bi bi-grid"></i>
        Dashboard
      </a>

      <a href="/feedback">
        <i class="bi bi-chat-left-text"></i>
        Manage Feedback
      </a>

      <a href="/report" class="active">
        <i class="bi bi-bar-chart"></i>
        Report
      </a>
    </nav>

    <div class="sidebar-footer">
      <p>Version 1.0.0</p>
      <span>© 2026 HR Feedback Portal</span>
    </div>
  </aside>

  <main class="main-content">
    <header class="top-header">
      <div>
        <h1>Feedback Report</h1>

        <p>
          Review feedback records based on their current status.
        </p>
      </div>

      <div class="report-header-actions">
        <a
          href="/report/pdf"
          class="download-report-button"
        >
          <i class="bi bi-file-earmark-pdf"></i>
          Download Full Report
        </a>

        <div class="user-box">
          <span>
            <i class="bi bi-person-circle"></i>

            <%= currentUser?.displayName || "HR Administrator" %>
          </span>

          <a href="/logout" class="logout-button">
            <i class="bi bi-box-arrow-right"></i>
            Logout
          </a>
        </div>
      </div>
    </header>

    <section class="report-status-navigation">
      <a href="#pending-section" class="report-status-link">
        <i class="bi bi-hourglass-split"></i>

        <div>
          <span>Pending</span>
          <strong><%= pendingList.length %></strong>
        </div>
      </a>

      <a href="#current-section" class="report-status-link">
        <i class="bi bi-arrow-repeat"></i>

        <div>
          <span>Current</span>
          <strong><%= inProgressList.length %></strong>
        </div>
      </a>

      <a href="#completed-section" class="report-status-link">
        <i class="bi bi-check-circle"></i>

        <div>
          <span>Completed</span>
          <strong><%= resolvedList.length %></strong>
        </div>
      </a>
    </section>

    <!-- Pending -->
    <section
      id="pending-section"
      class="report-list-section"
    >
      <div class="section-heading">
        <div>
          <h2>
            <i class="bi bi-hourglass-split"></i>
            Pending Feedback
          </h2>

          <p>
            Feedback that has not yet been reviewed by HR.
          </p>
        </div>

        <span class="report-record-count">
          <%= pendingList.length %> record(s)
        </span>
      </div>

      <% if (pendingList.length === 0) { %>

        <div class="report-empty-state">
          <i class="bi bi-inbox"></i>
          <h3>No pending feedback</h3>
          <p>There are currently no pending records.</p>
        </div>

      <% } else { %>

        <div class="report-feedback-list">
          <% pendingList.forEach((feedback) => { %>

            <article class="report-feedback-card">
              <div class="report-feedback-header">
                <div>
                  <h3><%= feedback.title || "-" %></h3>

                  <p class="feedback-category">
                    <i class="bi bi-tag"></i>
                    <%= feedback.category || "Uncategorized" %>
                  </p>
                </div>

                <span class="status pending">
                  Pending
                </span>
              </div>

              <p class="feedback-description">
                <%= feedback.message ||
                    feedback.description ||
                    "No description provided." %>
              </p>

              <div class="feedback-meta">
                <span>
                  <i class="bi bi-person"></i>

                  <strong>Submitted By:</strong>

                  <% if (feedback.is_anonymous === true) { %>
                    Anonymous
                  <% } else { %>
                    <%= feedback.submitted_by || "-" %>
                  <% } %>
                </span>

                <span>
                  <i class="bi bi-chat-square-text"></i>

                  <strong>HR Response:</strong>

                  <%= feedback.hr_response || "No response yet" %>
                </span>
              </div>

              <div class="report-card-actions">
                <a
                  href="/report/<%= feedback.id %>"
                  class="view-detail-button"
                >
                  <i class="bi bi-eye"></i>
                  View Details
                </a>
              </div>
            </article>

          <% }); %>
        </div>

      <% } %>
    </section>

    <!-- Current -->
    <section
      id="current-section"
      class="report-list-section"
    >
      <div class="section-heading">
        <div>
          <h2>
            <i class="bi bi-arrow-repeat"></i>
            Current Feedback
          </h2>

          <p>
            Feedback that is currently being reviewed or processed.
          </p>
        </div>

        <span class="report-record-count">
          <%= inProgressList.length %> record(s)
        </span>
      </div>

      <% if (inProgressList.length === 0) { %>

        <div class="report-empty-state">
          <i class="bi bi-inbox"></i>
          <h3>No current feedback</h3>
          <p>There are currently no records in progress.</p>
        </div>

      <% } else { %>

        <div class="report-feedback-list">
          <% inProgressList.forEach((feedback) => { %>

            <article class="report-feedback-card">
              <div class="report-feedback-header">
                <div>
                  <h3><%= feedback.title || "-" %></h3>

                  <p class="feedback-category">
                    <i class="bi bi-tag"></i>
                    <%= feedback.category || "Uncategorized" %>
                  </p>
                </div>

                <span class="status in-progress">
                  In Progress
                </span>
              </div>

              <p class="feedback-description">
                <%= feedback.message ||
                    feedback.description ||
                    "No description provided." %>
              </p>

              <div class="feedback-meta">
                <span>
                  <i class="bi bi-person"></i>

                  <strong>Submitted By:</strong>

                  <% if (feedback.is_anonymous === true) { %>
                    Anonymous
                  <% } else { %>
                    <%= feedback.submitted_by || "-" %>
                  <% } %>
                </span>

                <span>
                  <i class="bi bi-chat-square-text"></i>

                  <strong>HR Response:</strong>

                  <%= feedback.hr_response || "No response yet" %>
                </span>
              </div>

              <div class="report-card-actions">
                <a
                  href="/report/<%= feedback.id %>"
                  class="view-detail-button"
                >
                  <i class="bi bi-eye"></i>
                  View Details
                </a>
              </div>
            </article>

          <% }); %>
        </div>

      <% } %>
    </section>

    <!-- Completed -->
    <section
      id="completed-section"
      class="report-list-section"
    >
      <div class="section-heading">
        <div>
          <h2>
            <i class="bi bi-check-circle"></i>
            Completed Feedback
          </h2>

          <p>
            Feedback that has been reviewed and resolved by HR.
          </p>
        </div>

        <span class="report-record-count">
          <%= resolvedList.length %> record(s)
        </span>
      </div>

      <% if (resolvedList.length === 0) { %>

        <div class="report-empty-state">
          <i class="bi bi-inbox"></i>
          <h3>No completed feedback</h3>
          <p>There are currently no resolved records.</p>
        </div>

      <% } else { %>

        <div class="report-feedback-list">
          <% resolvedList.forEach((feedback) => { %>

            <article class="report-feedback-card">
              <div class="report-feedback-header">
                <div>
                  <h3><%= feedback.title || "-" %></h3>

                  <p class="feedback-category">
                    <i class="bi bi-tag"></i>
                    <%= feedback.category || "Uncategorized" %>
                  </p>
                </div>

                <span class="status resolved">
                  Resolved
                </span>
              </div>

              <p class="feedback-description">
                <%= feedback.message ||
                    feedback.description ||
                    "No description provided." %>
              </p>

              <div class="feedback-meta">
                <span>
                  <i class="bi bi-person"></i>

                  <strong>Submitted By:</strong>

                  <% if (feedback.is_anonymous === true) { %>
                    Anonymous
                  <% } else { %>
                    <%= feedback.submitted_by || "-" %>
                  <% } %>
                </span>

                <span>
                  <i class="bi bi-chat-square-text"></i>

                  <strong>HR Response:</strong>

                  <%= feedback.hr_response || "No response yet" %>
                </span>
              </div>

              <div class="report-card-actions">
                <a
                  href="/report/<%= feedback.id %>"
                  class="view-detail-button"
                >
                  <i class="bi bi-eye"></i>
                  View Details
                </a>
              </div>
            </article>

          <% }); %>
        </div>

      <% } %>
    </section>

    <footer class="system-footer">
      <p>HR Feedback Portal © 2026</p>
      <p>Developed by Fatin Nurul Anis</p>
    </footer>
  </main>
</body>
</html>